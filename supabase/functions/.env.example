# Env LOKAL untuk `supabase functions serve` / `supabase start`. Salin ke supabase/functions/.env
# (sudah di .gitignore). Untuk project asli: `supabase secrets set ...` — JANGAN commit nilai asli.
# Secret uji resmi Cloudflare (selalu lolos):
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Salt hash IP — isi string acak panjang (openssl rand -hex 32)
IP_HASH_SALT=ganti-dengan-string-acak-panjang
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# URL Supabase yang terlihat dari browser (lokal). Di project asli tidak perlu.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
