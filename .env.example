# Salin ke .env.local untuk pengembangan. JANGAN isi secret di sini.
# Repo ini publik: hanya URL proyek dan anon key (memang publik) yang boleh ada di frontend.

# URL proyek Supabase, mis. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
# Anon (publishable) key Supabase. Aman untuk frontend; akses dibatasi RLS.
VITE_SUPABASE_ANON_KEY=
# Site key Cloudflare Turnstile. Kunci uji resmi (selalu lolos): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Base path GitHub Pages, mis. /Logbook-HWTA-SPU/ . Kosong = '/' (dev lokal).
VITE_BASE=
# 1 = pakai data contoh tanpa Supabase (untuk demo / dev UI).
VITE_DEMO=1
